{
  "name": "onepc-guard",
  "productName": "OnePC Guard",
  "version": "1.1.1",
  "description": "Sicherheitscheck, Virenscan, Aufräumen und Backup für Windows",
  "author": "onemultimedia",
  "homepage": "https://www.onemultimedia.de",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "de.onemultimedia.onepcguard",
    "productName": "OnePC Guard",
    "copyright": "© onemultimedia",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "createDesktopShortcut": true,
      "shortcutName": "OnePC Guard",
      "artifactName": "OnePC-Guard-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mbverlagberlin-afk",
        "repo": "onepc-guard",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
